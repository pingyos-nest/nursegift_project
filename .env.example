# Copy to .env.local for local development. In Dokploy, set these under Environment instead.
# Never commit real values.

# --- MySQL / MariaDB
DB_HOST=localhost
DB_PORT=3306
DB_USER=
DB_PASSWORD=
DB_NAME=nursegift_db

# --- Admin login session (iron-session). Random string, 32+ characters:  openssl rand -base64 48
SESSION_SECRET=

# --- CMU Account (Microsoft Entra) OAuth
CMU_TENANT_ID=
CMU_CLIENT_ID=
CMU_CLIENT_SECRET=
# Must be registered as a Redirect URI on the Azure app
OAUTH_REDIRECT_URI=https://service.nurse.cmu.ac.th/dev/nursegift/admin/auth/callback

# --- Who can log in to /admin. Comma-separated CMU accounts, added as admin on startup
# (existing users are never changed; manage the rest at /admin/users).
INITIAL_ADMIN_EMAILS=

# --- Local-only login buttons without CMU OAuth (ignored when NODE_ENV=production)
DEV_LOGIN=false

# --- URL sub-path, fixed at build time (Dockerfile build arg). Leave as is for Dokploy.
# NEXT_PUBLIC_BASE_PATH=/dev/nursegift
